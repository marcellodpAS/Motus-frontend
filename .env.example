# Public values are embedded in the client bundle. Never add secrets here.
# iOS Simulator / web: http://localhost:8080
# Android Emulator:    http://10.0.2.2:8080
# Physical device:     http://<lan-ip-of-dev-machine>:8080
# See docs/motus/local-setup.md for details.
EXPO_PUBLIC_API_URL=

# XYZ raster-tile endpoint for the map (src/features/map/tileSource.ts).
# Optional: defaults to CARTO's public "Voyager" basemap (OpenStreetMap data),
# which is free but rate-limited and attribution-bound. Point this at an
# account-backed provider before shipping.
# Example: https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_URL=
